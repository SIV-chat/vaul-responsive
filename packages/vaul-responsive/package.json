{
  "name": "vaul-responsive",
  "version": "2.0.0",
  "description": "Vaul drawer for React that can also present as a dialog, without remounting its content.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "bun run check && bunchee && cp ./src/style.css ./style.css",
    "dev": "bunchee --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "react",
    "drawer",
    "dialog",
    "modal",
    "bottom-sheet",
    "responsive"
  ],
  "author": "Emil Kowalski <e@emilkowal.ski>",
  "contributors": [
    "Siv (https://siv.chat)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/SIV-chat/vaul-responsive",
  "repository": {
    "type": "git",
    "url": "https://github.com/SIV-chat/vaul-responsive.git",
    "directory": "packages/vaul-responsive"
  },
  "bugs": {
    "url": "https://github.com/SIV-chat/vaul-responsive/issues"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bunchee": "^7.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^16.8 || ^17.0 || ^18.0 || ^19.0.0",
    "react-dom": "^16.8 || ^17.0 || ^18.0 || ^19.0.0"
  }
}
